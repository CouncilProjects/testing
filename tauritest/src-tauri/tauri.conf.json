{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauritest",
  "version": "0.8.0",
  "identifier": "com.test.ghactions",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tauritest",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDRUEwNDZBOTJCNDNGNkYKUldSdlA3U1NhZ1RxcktnVEV5SVh6bkIvZkIrUGhJQ0FGbXA4aTRrbGdPMGxNU25HaFBmVTBFTVAK",
      "endpoints": [
        "https://github.com/CouncilProjects/testing/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
